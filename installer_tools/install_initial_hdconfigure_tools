#!/bin/sh

# ==============================================================================
# POSIX-Compliant Initial Tools Installation Script
# ==============================================================================
# This script copies the initial setup tools:
#   - /tmp/hdconfigure_tools/initial_tools/hdconfigure_tools_get
#   - /tmp/hdconfigure_tools/initial_tools/hdconfigure_tools_install
# into the target directory:
#   ~/.config/hdconfigure/tools/path
#
# According to official Debian/POSIX standards, each file's existence and 
# successful copy operation are rigorously validated.
#
# Every single step uses explicit if/then/else/fi statements to ensure 
# zero errors occur along the way.
# - If all checks pass successfully, prints the required success message to stderr and exits 0.
# - If any step fails, the 'else' block prints the required error message to stderr and exits 1.
# ==============================================================================

# Prerequisite: Verify HOME environment variable is set and points to a valid directory
if [ -n "${HOME:-}" ] && [ -d "$HOME" ]; then

    # Define the target destination directory path
    DEST_DIR="$HOME/.config/hdconfigure/tools/path"

    # Step 1: Verify that the destination directory exists
    if [ -d "$DEST_DIR" ]; then

        # Step 2: Verify the first source file exists
        SRC_GET="/tmp/hdconfigure_tools/initial_tools/hdconfigure_tools_get"
        if [ -f "$SRC_GET" ]; then

            # Step 3: Verify the second source file exists
            SRC_INSTALL="/tmp/hdconfigure_tools/initial_tools/hdconfigure_tools_install"
            if [ -f "$SRC_INSTALL" ]; then

                # Step 4: Copy hdconfigure_tools_get to the destination directory
                if cp "$SRC_GET" "$DEST_DIR/"; then

                    # Step 5: Verify hdconfigure_tools_get was successfully copied to destination
                    if [ -f "$DEST_DIR/hdconfigure_tools_get" ]; then

                        # Step 6: Copy hdconfigure_tools_install to the destination directory
                        if cp "$SRC_INSTALL" "$DEST_DIR/"; then

                            # Step 7: Verify hdconfigure_tools_install was successfully copied to destination
                            if [ -f "$DEST_DIR/hdconfigure_tools_install" ]; then

                                # Success: All files copied and verified successfully
                                echo "success: installed initial hdconfigure_tools" >&2
                                exit 0

                            else
                                # Error handling for Step 7 (Destination file check failed)
                                echo "error: failed to install initial hdconfigure_tools" >&2
                                exit 1
                            fi

                        else
                            # Error handling for Step 6 (Copy command failed for install script)
                            echo "error: failed to install initial hdconfigure_tools" >&2
                            exit 1
                        fi

                    else
                        # Error handling for Step 5 (Destination file check failed)
                        echo "error: failed to install initial hdconfigure_tools" >&2
                        exit 1
                    fi

                else
                    # Error handling for Step 4 (Copy command failed for get script)
                    echo "error: failed to install initial hdconfigure_tools" >&2
                    exit 1
                fi

            else
                # Error handling for Step 3 (Second source file missing)
                echo "error: failed to install initial hdconfigure_tools" >&2
                exit 1
            fi

        else
            # Error handling for Step 2 (First source file missing)
            echo "error: failed to install initial hdconfigure_tools" >&2
            exit 1
        fi

    else
        # Error handling for Step 1 (Destination directory does not exist)
        echo "error: failed to install initial hdconfigure_tools" >&2
        exit 1
    fi

else
    # Error handling for Prerequisite (HOME invalid or unset)
    echo "error: failed to install initial hdconfigure_tools" >&2
    exit 1
fi
