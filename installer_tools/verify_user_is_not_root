# ==============================================================================
# POSIX-Compliant Non-Root User Verification Script
# ==============================================================================
# This script verifies that the current user running the shell is NOT root
# according to official Debian and POSIX standards (using the 'id' utility).
#
# Every single step uses explicit if/then/else/fi statements to ensure 
# zero errors occur along the way.
# - If all checks pass successfully, prints the required success message to stderr and exits.
# - If any step fails, the 'else' block prints the required error message to stderr and exits.
# ==============================================================================

# Step 1: Verify that the 'id' utility is available on the system
if command -v id >/dev/null 2>&1; then

    # Step 2: Verify that executing 'id -u' succeeds and returns a valid status
    if id -u >/dev/null 2>&1; then

        # Step 3: Verify that the effective user ID is not equal to 0 (root)
        if [ "$(id -u)" != "0" ]; then

            # Success: All verification steps passed and user is confirmed non-root
            echo "success: verified that user is not root" >&2
            exit 0

        else
            # Error handling for Step 3 (User ID is 0, indicating the root user)
            echo "error: failed to verify that user is not root" >&2
            exit 1
        fi

    else
        # Error handling for Step 2 ('id -u' command execution failed)
        echo "error: failed to verify that user is not root" >&2
        exit 1
    fi

else
    # Error handling for Step 1 ('id' command not found in PATH)
    echo "error: failed to verify that user is not root" >&2
    exit 1
fi
