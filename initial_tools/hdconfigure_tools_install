set -eu

# Helper function to print messages to stderr
print_msg() {
    printf "%s\n" "$1" >&2
}

# Verify required arguments are provided
if [ $# -lt 2 ]; then
    print_msg "Error: Missing arguments."
    print_msg "Usage: $0 <github_username> <repository_name>"
    exit 1
fi

GITHUB_USERNAME="$1"
REPOSITORY_NAME="$2"

SRC_DIR="$HOME/.config/hdconfigure/tools/git/$GITHUB_USERNAME/$REPOSITORY_NAME/hdconfigure/tools/path"
DEST_DIR="$HOME/.config/hdconfigure/tools/path"

# Check if the source directory exists
if [ ! -d "$SRC_DIR" ]; then
    print_msg "Error: Source directory does not exist: $SRC_DIR"
    exit 1
fi

print_msg "Ensuring destination directory exists: $DEST_DIR"
mkdir -p "$DEST_DIR"

print_msg "Copying files from $SRC_DIR to $DEST_DIR..."
# Check if source directory contains files before copying
if [ -n "$(ls -A "$SRC_DIR" 2>/dev/null)" ]; then
    cp -R "$SRC_DIR"/* "$DEST_DIR"/
else
    print_msg "Error: Source directory is empty: $SRC_DIR"
    exit 1
fi

print_msg "Granting execute permissions..."
chmod +x "$DEST_DIR"/*

print_msg "Operation completed successfully."
